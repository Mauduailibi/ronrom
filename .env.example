# Neon: Dashboard → Connect → marque "Connection pooling" e copie a URL (host com -pooler)
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Segredo do Better Auth (gere com: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Endereço público do site. Em dev é o Vite; na Vercel, o domínio de produção.
BETTER_AUTH_URL=http://localhost:5173

# Google (opcional: sem estas variáveis o botão do Google não aparece)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outros domínios autorizados, separados por vírgula (ex.: um domínio próprio além do .vercel.app)
TRUSTED_ORIGINS=
